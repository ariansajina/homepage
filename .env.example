# Public base URL of the R2 bucket (its custom domain), no trailing slash.
# Unset in local dev: media is then served from public/media/.
PUBLIC_MEDIA_URL=https://media.example.com

# Canonical site URL, used for <link rel="canonical">, Open Graph and the sitemap.
SITE_URL=https://example.com

# Feature flags (src/lib/features.ts). "true" shows the Traces page; unset or "false" hides it.
FEATURE_TRACES=false
