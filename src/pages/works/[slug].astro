---
import { render } from "astro:content";
import Sub from "../../layouts/Sub.astro";
import { sortedWorks } from "../../lib/content";
import { media } from "../../lib/media";

export async function getStaticPaths() {
  return (await sortedWorks()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const w = entry.data;
const { Content } = await render(entry);
// Falls back to the site's default description when the work has no text.
const description = (entry.body ?? "").replace(/\s+/g, " ").trim().slice(0, 160) || undefined;

// Justified rows (desktop): photos are grouped so each row's summed aspect ratio comes
// close to TARGET. In a row every photo grows in proportion to its ratio, so all photos
// in it share one height and the row fills the width. Only a last row under three
// quarters full keeps the target height and is just as wide as it needs to be.
const TARGET = 4;
const photos = w.photos.map((p) => ({
  ...p,
  ratio: p.width && p.height ? p.width / p.height : 3 / 2,
}));
const total = photos.reduce((sum, p) => sum + p.ratio, 0);
// Few photos: one taller row that fills the width rather than a short, narrow one.
const target = Math.min(TARGET, Math.max(1.6, total));
const rows: { photos: typeof photos; sum: number }[] = [];
let row: typeof photos = [];
let sum = 0;
for (const p of photos) {
  // Close the row before this photo when stopping here lands nearer the target.
  if (row.length && sum + p.ratio > target && target - sum < sum + p.ratio - target) {
    rows.push({ photos: row, sum });
    row = [];
    sum = 0;
  }
  row.push(p);
  sum += p.ratio;
  if (sum >= target) {
    rows.push({ photos: row, sum });
    row = [];
    sum = 0;
  }
}
if (row.length) {
  // A lone short last row joins the previous one when it is less than half a row.
  const prev = rows.at(-1);
  if (prev && sum < target / 2) {
    prev.photos.push(...row);
    prev.sum += sum;
  } else rows.push({ photos: row, sum });
}
---

<Sub title={w.title} description={description} back="/works/" showHome>
  <div class="view">
    <article class="work">
      <h1>{w.title}</h1>
      <p class="year">{w.year}</p>
      <div class="text">
        <Content />
      </div>
      {w.photos.length > 0 && (
        <div class:list={["photos", { solo: photos.length === 1 }]}>
          {rows.map((r, i) => (
            <div
              class="row"
              style={`--fill: ${i < rows.length - 1 || r.sum >= target * 0.75 ? 1 : r.sum / target}`}
            >
              {r.photos.map((p) => (
                <figure style={`--ratio: ${p.ratio}`}>
                  <img
                    src={media(p.src)}
                    alt={p.caption ?? w.title}
                    width={p.width}
                    height={p.height}
                    loading="lazy"
                    decoding="async"
                  />
                  {p.caption && <figcaption>{p.caption}</figcaption>}
                </figure>
              ))}
            </div>
          ))}
        </div>
      )}
      {w.link && (
        <p class="txt link">
          <a href={w.link.href} target="_blank" rel="noopener">
            {w.link.label}
          </a>
        </p>
      )}
      {w.shows.length > 0 && (
        <dl class="rows shows">
          {w.shows.map((r) => (
            <div>
              <dt>{r.when}</dt>
              <dd>{r.where}</dd>
            </div>
          ))}
        </dl>
      )}
      {w.credits.length > 0 && (
        <dl class="rows credits">
          {w.credits.map((r) => (
            <div>
              <dt>{r.role}</dt>
              <dd>{r.name}</dd>
            </div>
          ))}
        </dl>
      )}
    </article>
  </div>
</Sub>

<style>
  .work {
    width: 100%;
    max-width: 34em;
    font-size: 17px;
    line-height: 1.6;
  }
  h1 {
    margin: 0;
    font-size: inherit;
    font-weight: 400;
    text-transform: lowercase;
  }
  .year {
    margin: 0 0 1.6em;
    color: var(--muted);
  }
  .text :global(p),
  .text :global(blockquote) {
    margin: 0;
  }
  .text :global(* + p),
  .text :global(* + blockquote) {
    margin-top: 1em;
  }
  .text :global(blockquote) {
    padding-left: 1em;
    border-left: 1px solid var(--muted);
    color: var(--muted);
  }
  .photos,
  .row {
    display: grid;
    gap: 1em;
  }
  .photos {
    margin-top: 1.6em;
  }
  /* Desktop: the photos break out of the text column into justified rows. */
  @media (min-width: 601px) {
    .photos {
      --gap: 8px;
      gap: var(--gap);
      width: min(960px, 100vw - 64px);
      margin-left: 50%;
      translate: -50% 0;
    }
    .row {
      display: flex;
      gap: var(--gap);
      width: calc(var(--fill) * 100%);
    }
    /* A single photo sits centred under the text. */
    .solo .row {
      margin-inline: auto;
    }
    .row figure {
      /* Scaled: grow values that sum below 1 would leave part of the row empty. */
      flex: calc(var(--ratio) * 100) 1 0;
      min-width: 0;
    }
  }
  .photos figure {
    margin: 0;
  }
  .photos img {
    display: block;
    width: 100%;
    height: auto;
  }
  .photos figcaption {
    margin-top: 0.3em;
    font-size: 15px;
    color: var(--muted);
  }
  .link {
    margin: 0.6em 0 0;
  }
  .rows {
    margin: 1.6em 0 0;
    font-size: 15px;
    line-height: 1.55;
  }
  .shows {
    margin-top: 2.2em;
  }
  .rows div {
    display: grid;
    grid-template-columns: 7.5em minmax(0, 1fr);
    column-gap: 1em;
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
  }
</style>
