---
import Sub from "../layouts/Sub.astro";
import { getEntry, render } from "astro:content";
import { media } from "../lib/media";

const photo = media("about/arian.jpg");
const video = media("about/arian.mp4");

const entry = await getEntry("about", "about");
if (!entry) throw new Error("src/content/about.md is missing");
const { Content } = await render(entry);
---

<Sub
  title="About"
  description="I break and engage with performing arts. A naši speaker from Istria, based in Copenhagen."
  backText="back at last"
>
  <div class="view">
    <div class="about-wrap">
      <video
        class="about-img"
        src={video}
        poster={photo}
        width="1280"
        height="2276"
        autoplay
        muted
        loop
        playsinline
        controls
        data-about-video
        aria-label="Arian Šajina"
      ></video>
      <div class="txt about-text">
        <Content />
      </div>
    </div>
  </div>
</Sub>

<script>
  import "../scripts/about-video";
</script>

<style>
  .about-wrap {
    display: flex;
    flex-direction: column;
    gap: 44px;
    align-items: flex-start;
    width: 100%;
    max-width: 40em;
  }
  .about-img {
    order: 2;
    flex: 0 0 auto;
    display: block;
    width: 300px;
    max-width: 100%;
    height: auto;
  }
  .about-text {
    width: 100%;
    min-width: 0;
    font-size: clamp(13px, calc(1.6vh + 2px), 17px);
    line-height: 1.55;
  }
  .about-text :global(p) {
    margin: 0 0 1em;
  }
  .about-text :global(p:last-child) {
    margin: 0;
  }
  /* Desktop: text on the left, video on the right, both inside one screen. The video
     is portrait, so its height (not width) is what is capped to the viewport. */
  @media (min-width: 761px) {
    .about-wrap {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 56px;
      max-width: 62em;
    }
    .about-text {
      flex: 1 1 0;
      max-width: 36em;
    }
    .about-img {
      width: auto;
      height: min(calc(100vh - 210px), 640px);
      max-width: 40%;
      object-fit: contain;
    }
  }
  @media (max-width: 760px) {
    .about-wrap {
      gap: 32px;
    }
    .about-img {
      width: min(100%, 360px);
    }
  }
  @media (max-width: 600px) {
    .about-text {
      font-size: 15px;
      line-height: 1.5;
    }
  }
</style>
