---
// Landing page: four menu words that scramble between English, German, Italian and
// Croatian (Latin, Cyrillic, Glagolitic), over a background video revealed by a slowly
// spreading stain that starts on the island of Vis.
// Behaviour: src/scripts/scramble.ts, src/scripts/background.ts.
import Base from "../layouts/Base.astro";
import { media } from "../lib/media";

// Order: English, German, Italian, Croatian (Latin), Croatian (Cyrillic), Croatian (Glagolitic)
const entries = [
  { href: "/about/", words: ["About", "Über mich", "Chi sono", "O meni", "О мени", "Ⱁ ⰿⰵⱀⰻ"] },
  { href: "/works/", words: ["Works", "Werke", "Lavori", "Radovi", "Радови", "Ⱃⰰⰴⱁⰲⰻ"] },
  { href: "/letters/", words: ["Letters", "Briefe", "Lettere", "Pisma", "Писма", "Ⱂⰻⱄⰿⰰ"] },
  { href: "/dances/", words: ["Dances", "Tänze", "Danze", "Plesovi", "Плесови", "Ⱂⰾⰵⱄⱁⰲⰻ"] },
].map((e) => ({ ...e, words: e.words.map((w) => w.toLowerCase()) }));

const video = { webm: media("landing/background.webm"), mp4: media("landing/background.mp4") };
---

<Base>
  <main class="landing">
    <video
      class="bgv"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
      tabindex="-1"
      data-bg-video
    >
      <source src={video.webm} type="video/webm" />
      <source src={video.mp4} type="video/mp4" />
    </video>
    <canvas class="bgc" width="533" height="461" aria-hidden="true" data-stain></canvas>
    <ul class="menu" data-scramble={JSON.stringify(entries.map((e) => e.words))}>
      {entries.map((e) => (
        <li>
          <a href={e.href} aria-label={e.words[0]}>
            <span aria-hidden="true">{e.words[0]}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .landing {
    box-sizing: border-box;
    min-height: 100vh;
    width: 100%;
    padding: 64px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 400;
    position: relative;
    overflow: hidden;
  }
  .bgv,
  .bgc {
    position: absolute;
    left: 61%;
    top: 52.8%;
    transform: translateY(-50%);
    width: 37%;
    height: auto;
    aspect-ratio: 1490 / 1290;
    display: block;
    pointer-events: none;
    z-index: 0;
    image-rendering: pixelated;
  }
  .bgv {
    object-fit: cover;
    object-position: 50% 40%;
    mix-blend-mode: multiply;
    -webkit-mask-image: url(/stain-mask.png);
    mask-image: url(/stain-mask.png);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }
  .menu {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    width: 10em;
    text-align: center;
    text-transform: lowercase;
    font-size: 28px;
    line-height: 1.7;
    transform: translateY(max(-8vh, calc(170px - 50vh)));
  }
  .menu li {
    margin: 0;
    padding: 0;
    height: 1.7em;
    white-space: nowrap;
  }
  @media (max-width: 800px) {
    .bgv,
    .bgc {
      left: auto;
      right: 0;
      top: auto;
      bottom: 0;
      transform: none;
      width: 90vw;
    }
  }
  @media (max-width: 600px) {
    .menu {
      font-size: 24px;
      transform: translateY(-7vh);
    }
    .bgv,
    .bgc {
      width: 100vw;
      left: 0;
      right: auto;
    }
  }
</style>

<script>
  import "../scripts/scramble";
  import "../scripts/background";
</script>
