---
// Landing page: menu words that scramble between English, German, Italian and Croatian
// (Latin, Cyrillic, Glagolitic), over a background video revealed by a slowly spreading
// stain that starts on the island of Vis. Everything tweakable lives in
// src/config/landing.yaml. Behaviour: src/scripts/{scramble,stain,landing-video}.ts.
import Base from "../layouts/Base.astro";
import { media } from "../lib/media";
import { landing, maskSize } from "../lib/landing-config";
import { features, type FeatureName } from "../lib/features";

// Menu items with a `feature` are left out while that flag is off.
const entries = landing.menu
  .filter((e) => !e.feature || features[e.feature as FeatureName])
  .map((e) => ({
    href: e.href,
    words: e.words.map((w) => w.toLowerCase()),
  }));
const scramble = { words: entries.map((e) => e.words), timing: landing.scramble };
const { video, mask } = landing.background;
// The stain grid follows the mask's aspect ratio.
const grid = {
  width: landing.stain.resolution,
  height: Math.round((landing.stain.resolution * maskSize.height) / maskSize.width),
};
const frameStyle = `--mask: url('${mask}'); --video-pos: ${landing.background.position}; --aspect: ${maskSize.width} / ${maskSize.height}`;
---

<Base>
  <main class="landing" style={frameStyle}>
    <video
      class="bgv"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
      tabindex="-1"
      data-bg-video
    >
      {video.webm && <source src={media(video.webm)} type="video/webm" />}
      {video.mp4 && <source src={media(video.mp4)} type="video/mp4" />}
    </video>
    <canvas
      class="bgc"
      width={grid.width}
      height={grid.height}
      aria-hidden="true"
      data-stain={JSON.stringify(landing.stain)}
      data-mask={mask}
    ></canvas>
    <ul class="menu" data-scramble={JSON.stringify(scramble)}>
      {entries.map((e) => (
        <li>
          <a href={e.href} aria-label={e.words[0]}>
            <span aria-hidden="true">{e.words[0]}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .landing {
    box-sizing: border-box;
    min-height: 100vh;
    width: 100%;
    padding: 64px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 400;
    position: relative;
    overflow: hidden;
    --fs: 28px; /* menu font size */
  }
  .bgv,
  .bgc {
    position: absolute;
    left: 61%;
    top: 52.8%;
    transform: translateY(-50%);
    width: 37%;
    height: auto;
    aspect-ratio: var(--aspect);
    display: block;
    pointer-events: none;
    z-index: 0;
    image-rendering: pixelated;
  }
  .bgv {
    object-fit: cover;
    object-position: var(--video-pos, 50% 40%);
    mix-blend-mode: multiply;
    -webkit-mask-image: var(--mask);
    mask-image: var(--mask);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }
  .menu {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    width: 10em;
    text-align: center;
    text-transform: lowercase;
    font-size: var(--fs);
    line-height: 1.7;
  }
  .menu li {
    margin: 0;
    padding: 0;
    height: 1.7em;
    white-space: nowrap;
  }
  @media (max-width: 800px) {
    .bgv,
    .bgc {
      left: auto;
      right: 0;
      top: auto;
      bottom: 0;
      transform: none;
      width: 90vw;
    }
  }
  @media (max-width: 600px) {
    .landing {
      --fs: 24px;
    }
    .bgv,
    .bgc {
      width: 100vw;
      left: 0;
      right: auto;
    }
  }
</style>

<script>
  import "../scripts/scramble";
  import "../scripts/stain";
  import "../scripts/landing-video";
</script>
