---
// A sub page (everything but the landing page): the base shell plus the top bar.
import Base from "./Base.astro";
import TopBar from "../components/TopBar.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  back?: string;
  backText?: string;
  showHome?: boolean;
}

const { back = "/", backText, showHome, ...head } = Astro.props;
---

<Base {...head}>
  <TopBar back={back} backText={backText} showHome={showHome} />
  <main>
    <slot />
  </main>
</Base>
