# Serves the static build. Railway terminates TLS and routes to $PORT.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Hashed build assets never change; everything else revalidates.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header -Server
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
